#!/usr/bin/env python3

import json
import sys


def main():
    args = sys.argv[1:]
    if not args:
        print("jq compat: missing filter", file=sys.stderr)
        return 2

    if args == ["--version"]:
        print("jq-compat 0.1")
        return 0

    raw_output = False
    while args and args[0].startswith("-"):
        flag = args.pop(0)
        if flag == "-r":
            raw_output = True
            continue
        print(f"jq compat: unsupported flag {flag}", file=sys.stderr)
        return 2

    if not args:
        print("jq compat: missing filter", file=sys.stderr)
        return 2

    flt = args.pop(0)
    if args:
        print("jq compat: file arguments are not supported", file=sys.stderr)
        return 2

    data = json.load(sys.stdin)

    if flt == "try (.installed_chaincodes[].package_id)":
        items = data.get("installed_chaincodes") or []
        for item in items:
            value = item.get("package_id")
            if value is None:
                continue
            print(value)
        return 0

    if flt == ".":
        if raw_output and isinstance(data, str):
            print(data)
        else:
            print(json.dumps(data, ensure_ascii=False))
        return 0

    print(f"jq compat: unsupported filter {flt}", file=sys.stderr)
    return 2


if __name__ == "__main__":
    raise SystemExit(main())
