// Task lifecycle state machine for the MA3C verification protocol (paper §IV.A).
// Render:  dot -Tpdf fig_state_machine.dot -o fig_state_machine.pdf
//          dot -Tpng -Gdpi=300 fig_state_machine.dot -o fig_state_machine.png
digraph TaskLifecycle {
    rankdir=LR;
    bgcolor="white";
    pad=0.2;
    nodesep=0.45;
    ranksep=0.8;
    fontname="Times-Roman";
    node [shape=box, style="rounded,filled", fontname="Times-Roman", fontsize=12,
          penwidth=1.6, margin="0.16,0.09"];
    edge [fontname="Times-Italic", fontsize=9, color="#555555", arrowsize=0.8];

    // --- process states (blue) ---
    PENDING     [fillcolor="#E3EFEF", color="#2A9D8F", label="PENDING"];
    COLLECTING  [fillcolor="#E3EFEF", color="#2A9D8F", label="COLLECTING"];
    VERIFYING   [fillcolor="#E3EFEF", color="#2A9D8F", label="VERIFYING"];

    // --- escalation state (coral, the distinguishing arbitration path) ---
    ARBITRATING [fillcolor="#FCEEE9", color="#E76F51", penwidth=2.0, label="ARBITRATING"];

    // --- terminal states ---
    CONFIRMED [fillcolor="#D8EBE0", color="#2A9D8F", peripheries=2, label="CONFIRMED"];
    REJECTED  [fillcolor="#F6DDD6", color="#E76F51", peripheries=2, label="REJECTED"];
    TIMEOUT   [fillcolor="#EAEAEA", color="#8C8C8C", peripheries=2, label="TIMEOUT"];

    // entry point
    start [shape=point, width=0.12, color="#2C2C2C"];
    start -> PENDING;

    // --- transitions ---
    PENDING    -> COLLECTING  [label="VRF committee\nselected"];
    COLLECTING -> VERIFYING   [label="dual-collector\nevidence agreed"];
    COLLECTING -> ARBITRATING [label="collector\nconflict"];
    COLLECTING -> TIMEOUT     [label="evidence missing\n(after retry)"];

    VERIFYING  -> CONFIRMED   [label="acceptRatio ≥ θ"];
    VERIFYING  -> REJECTED    [label="rejectRatio ≥ θ  /\ncrypto precheck fail"];
    VERIFYING  -> ARBITRATING [label="disagreement\n(1−θ, θ) / few reveals"];

    ARBITRATING -> CONFIRMED  [label="arbiter accept"];
    ARBITRATING -> REJECTED   [label="arbiter reject"];
    ARBITRATING -> TIMEOUT    [label="no arbiter quorum"];

    // keep terminals aligned on the right
    { rank=same; CONFIRMED; REJECTED; TIMEOUT; }
}
