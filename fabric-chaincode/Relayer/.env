# Agent LLM Configuration
#
# Local Ollama backend (RTX 3090 Ti on the host). Free, no API key, no VPN,
# not affected by relay-station outages. Containers reach the host's Ollama via
# host.docker.internal (mapped to host-gateway in docker-compose.agents.yml).
LLM_BACKEND=ollama
# Agents use host networking (see docker-compose.agents.yml), so they reach the host's
# Ollama over loopback — ufw permits loopback, avoiding the bridge->host block.
LLM_BASE_URL=http://127.0.0.1:11434

# Not used by the Ollama backend; kept blank to avoid leaking old relay keys.
OPENAI_API_KEY=

# Model assignments per agent type (heterogeneous B vs C strategies)
# A_PROOF_VALIDATOR agents (proof-01, proof-02) don't use LLM (rule-based)
# B_POLICY_CHECKER agent (policy-01)
LLM_MODEL_POLICY=llama3.1:8b
# C_SEMANTIC_REASONER agents (semantic-01, semantic-02)
LLM_MODEL_SEMANTIC=qwen2.5:14b

