{
  "relayer": {
    "name": "CrossChain-Relayer-01",
    "privateKey": "0x...",
    "logLevel": "info",
    "blockConfirmations": 3,
    "retryAttempts": 3,
    "retryDelay": 5000
  },
  "chains": [
    {
      "chainId": "FISCO_BCOS_NET_01",
      "type": "FISCO_BCOS",
      "enabled": true,
      "rpc": {
        "endpoint": "http://127.0.0.1:8545",
        "evidenceEndpoints": {
          "fisco-node-0": "http://127.0.0.1:8542",
          "fisco-node-1": "http://127.0.0.1:8543"
        }
      },
      "contracts": {
        "gateway": "0x...",
        "registry": "0x...",
        "lightClient": "0x...",
        "semanticAuditAnchor": "0x...",
        "supplyChainEvidence": "0x..."
      },
      "certificates": {
        "ca": "./certs/fisco/ca.crt",
        "node": "./certs/fisco/node.crt",
        "nodeKey": "./certs/fisco/node.key"
      },
      "monitoring": {
        "startBlock": "latest",
        "pollInterval": 3000,
        "events": [
          "CrossChainCall",
          "MessageReceived"
        ]
      }
    },
    {
      "chainId": "FABRIC_NET_01",
      "type": "FABRIC",
      "enabled": true,
      "connection": {
        "cryptoPath": "/path/to/fabric-samples/test-network/organizations/peerOrganizations/org1.example.com",
        "channelName": "mychannel",
        "peerEndpoint": "localhost:7051",
        "peerHostAlias": "peer0.org1.example.com",
        "mspId": "Org1MSP",
        "evidenceEndpoints": {
          "fabric-peer-0": {
            "peerEndpoint": "localhost:7051",
            "peerHostAlias": "peer0.org1.example.com"
          },
          "fabric-peer-1": {
            "peerEndpoint": "localhost:9051",
            "peerHostAlias": "peer0.org2.example.com",
            "tlsCryptoPath": "/path/to/fabric-samples/test-network/organizations/peerOrganizations/org2.example.com"
          }
        }
      },
      "contracts": {
        "gateway": "gateway_cc",
        "registry": "registry_cc",
        "lightClient": "lightclient_cc"
      },
      "monitoring": {
        "startBlock": "latest",
        "pollInterval": 5000,
        "events": [
          "CrossChainCall",
          "MessageReceived"
        ]
      }
    }
  ],
  "database": {
    "type": "sqlite",
    "path": "./data/relayer.db"
  },
  "api": {
    "enabled": true,
    "port": 8080,
    "host": "0.0.0.0"
  }
}
